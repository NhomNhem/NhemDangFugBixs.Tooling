#!/usr/bin/env bash
set -euo pipefail

if [[ "${NHEM_SKIP_DEPLOY_HOOK:-0}" == "1" ]]; then
  exit 0
fi

remote_name="${1:-origin}"
remote_url="${2:-}"
unset remote_url

echo "[Nhem] pre-push: running build and tests..."

if [ -f "Source~/NhemDangFugBixs.Tooling.sln" ]; then
  dotnet build "Source~/DangFugBixs.Generators~/DangFugBixs.Tests/DangFugBixs.Tests.csproj" -c Release
  dotnet test "Source~/DangFugBixs.Generators~/DangFugBixs.Tests/DangFugBixs.Tests.csproj" -c Release --no-build
  dotnet test "Source~/DangFugBixs.Analyzers~/DangFugBixs.Analyzers.Tests/DangFugBixs.Analyzers.Tests.csproj" -c Release
  dotnet test "Source~/DangFugBixs.Tools~/DangFugBixs.DiSmokeValidation.Tests/DangFugBixs.DiSmokeValidation.Tests.csproj" -c Release
else
  echo "[Nhem] WARNING: Source~/NhemDangFugBixs.Tooling.sln not found. Skipping dotnet validation."
fi

# Read ref updates from STDIN, then decide if we need deploy sync.
should_sync_deploy=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_ref" == "refs/heads/main" || "$local_ref" == "refs/heads/master" ]]; then
    should_sync_deploy=1
  fi
done

if [[ "$should_sync_deploy" == "1" ]]; then
  current_branch="$(git rev-parse --abbrev-ref HEAD)"
  echo "[Nhem] pre-push: syncing deploy branch from $current_branch"
  bash "scripts/sync-deploy-branch.sh" "$remote_name" "$current_branch" "deploy"
fi

echo "[Nhem] pre-push passed."
