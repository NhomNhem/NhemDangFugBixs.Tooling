---
const { items = [] } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
    {items.map((item) => (
            <article class="nhem-card p-6">
                <h3 class="font-display text-2xl tracking-[-0.035em] text-ink">
                    {item.title}
                </h3>

                <p class="mt-3 leading-7 text-body">
                    {item.description}
                </p>
            </article>
    ))}
</div>